<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %></title>
  <!-- Letras de Google Fonts: Caveat (a mano) y Nunito (texto) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Nunito:wght@400;600;700&display=swap">
  <link rel="stylesheet" href="/estilos.css">
</head>
<body>
  <div class="contenedor">
    <header>
      <!-- Ícono de lápiz -->
      <svg class="lapiz" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
      <h1><%= titulo %></h1>
      <!-- Línea ondulada, como un trazo a mano -->
      <svg class="trazo" width="260" height="16" viewBox="0 0 260 16" fill="none" aria-hidden="true"><path d="M4 10 C 40 3, 70 14, 110 8 S 180 3, 210 9 S 245 12, 256 6" stroke-width="3" stroke-linecap="round"></path></svg>
      <p class="subtitulo">Mis dibujos, guardados uno por uno.</p>
    </header>

    <section class="panel">
      <h2>Subir un dibujo</h2>
      <form action="/subir" method="POST" enctype="multipart/form-data">
        <div class="campo">
          <label for="titulo">Título</label>
          <input type="text" id="titulo" name="titulo" required>
        </div>
        <div class="campo">
          <label for="descripcion">Descripción</label>
          <textarea id="descripcion" name="descripcion" rows="3"></textarea>
        </div>
        <div class="campo">
          <label for="imagen">Imagen</label>
          <div class="zona-imagen">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-4.5-4.5L5 21"></path></svg>
            <input type="file" id="imagen" name="imagen" accept="image/*" required>
          </div>
        </div>
        <button type="submit">Subir</button>
      </form>
    </section>

    <section>
      <h2 class="titulo-galeria">Mis dibujos</h2>
      <% if (dibujos.length === 0) { %>
        <p class="vacio">Aquí aparecerán mis dibujos 🎨</p>
      <% } %>
      <div class="galeria">
        <% dibujos.forEach(d => { %>
          <figure class="dibujo">
            <span class="cinta" aria-hidden="true"></span>
            <img src="/images/<%= d.archivo %>" alt="<%= d.titulo %>">
            <figcaption>
              <strong class="titulo"><%= d.titulo %></strong>
              <% if (d.descripcion) { %><p class="descripcion"><%= d.descripcion %></p><% } %>
            </figcaption>
          </figure>
        <% }) %>
      </div>
    </section>
  </div>

  <!-- Ventana para ver un dibujo en grande; se abre desde galeria.js -->
  <dialog id="visor">
    <img id="visor-imagen" src="" alt="">
    <p id="visor-titulo"></p>
  </dialog>

  <script src="/galeria.js"></script>
</body>
</html>
